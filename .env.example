# Plantilla de variables. Copiar a .env y completar.
#
#   cp .env.example .env
#
# Este archivo SI se sube al repo: va sin valores reales.
# El .env, no.

# --- Telegram ---

# A donde manda el bot las notificaciones.
# Es el id del grupo, y va en NEGATIVO (ej: -5470733730).
# Para sacarlo: agregar el bot al grupo, mandar un mensaje, y abrir
# https://api.telegram.org/bot<TOKEN>/getUpdates — el id esta en "chat".
TELEGRAM_ADMIN_CHAT_ID=

# El token que da @BotFather al crear el bot.
# NUNCA pegarlo en el .env.example ni en una captura de pantalla:
# con el token solo, cualquiera maneja el bot.
TELEGRAM_BOT_TOKEN=

# --- Base de datos ---

# Archivo SQLite. En Docker apunta al volumen; no hace falta tocarlo.
SQLITE_PATH=/app/data/sanguchitos.db
